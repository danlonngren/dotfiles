#!/usr/bin/env python3
"""Create and keep alive a remote SSH port-forwarding tunnel."""

from __future__ import annotations

import argparse
import asyncio
from dataclasses import dataclass

try:
    import asyncssh
except ModuleNotFoundError:
    asyncssh = None


@dataclass(frozen=True)
class PortForward:
    remote_port: int
    local_host: str
    local_port: int


class AsyncSSHClient:
    def __init__(self, host: str, username: str, ssh_port: int) -> None:
        self.host = host
        self.username = username
        self.ssh_port = ssh_port
        self.connection: asyncssh.SSHClientConnection | None = None
        self.forward: asyncssh.SSHListener | None = None

    async def connect(self, forward: PortForward) -> None:
        self.connection = await asyncssh.connect(
            self.host,
            port=self.ssh_port,
            username=self.username,
        )
        self.forward = await self.connection.forward_remote_port(
            "",
            forward.remote_port,
            forward.local_host,
            forward.local_port,
        )

    async def close(self) -> None:
        if self.forward is not None:
            self.forward.close()
            self.forward = None
        if self.connection is not None:
            self.connection.close()
            await self.connection.wait_closed()
            self.connection = None


def parse_target(value: str) -> tuple[str, str]:
    try:
        username, host = value.split("@", maxsplit=1)
    except ValueError as error:
        raise argparse.ArgumentTypeError("target must be in the form user@host") from error
    if not username or not host:
        raise argparse.ArgumentTypeError("target must be in the form user@host")
    return username, host


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Create a remote SSH port-forwarding tunnel until interrupted."
    )
    parser.add_argument("target", type=parse_target, help="SSH target, e.g. user@example.com")
    parser.add_argument("--remote-port", type=int, required=True, help="Remote port to listen on")
    parser.add_argument(
        "--local-host", default="127.0.0.1", help="Local host to forward to"
    )
    parser.add_argument("--local-port", type=int, required=True, help="Local port to forward to")
    parser.add_argument("--ssh-port", type=int, default=22, help="SSH server port")
    return parser.parse_args()


async def main() -> None:
    args = parse_args()
    if asyncssh is None:
        raise SystemExit("Missing dependency: install it with python3 -m pip install -r requirements.txt")
    username, host = args.target
    client = AsyncSSHClient(host, username, args.ssh_port)
    forward = PortForward(args.remote_port, args.local_host, args.local_port)

    try:
        await client.connect(forward)
        print(
            f"Forwarding remote port {forward.remote_port} to "
            f"{forward.local_host}:{forward.local_port}. Press Ctrl-C to stop."
        )
        await asyncio.Event().wait()
    except KeyboardInterrupt:
        pass
    finally:
        await client.close()


if __name__ == "__main__":
    asyncio.run(main())
