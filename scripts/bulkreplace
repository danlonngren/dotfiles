#!/usr/bin/env bash

set -euo pipefail

if (($# < 2 || $# > 3)); then
	echo "Usage: $(basename "$0") <search-regex> <replacement> [directory]" >&2
	exit 1
fi

old=$1
new=$2
root=${3:-.}

if [[ ! -d "$root" ]]; then
	echo "Directory not found: $root" >&2
	exit 1
fi

replace_file() {
	local file=$1
	if sed --version >/dev/null 2>&1; then
		sed -i "s/$old/$new/g" "$file"
	else
		sed -i '' "s/$old/$new/g" "$file"
	fi
}

while IFS= read -r -d '' file; do
	replace_file "$file"
done < <(find "$root" -type f -print0)
