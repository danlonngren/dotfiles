# Shared Bash and Zsh configuration.

# Helper
__dotfiles_require() {
	local tool

	for tool in "$@"; do
		if ! command -v "$tool" >/dev/null 2>&1; then
			printf 'This command requires %s, but it is not installed or not on PATH.\n' "$tool" >&2
			return 1
		fi
	done
}

# ------------------------------------------------------------
# Path
# ------------------------------------------------------------
export REPOS="$HOME/git"
export GHREPOS="$REPOS/github.com/$GITUSER"
export ICLOUD="$HOME/icloud"
export DOTSCRIPTS="$HOME/scripts"

if command -v brew >/dev/null 2>&1; then
	llvm_bin="$(brew --prefix llvm 2>/dev/null)/bin"
	[[ -d "$llvm_bin" ]] && export PATH="$llvm_bin:$PATH"
	unset llvm_bin
fi

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/dotnet:$DOTSCRIPTS:$PATH"

# ------------------------------------------------------------
# Aliases
# ------------------------------------------------------------
alias v='vim'
alias c='clear'
alias e='exit'
alias tm='tmux'
alias pstatus='echo "${pipestatus[*]}"'

# Paths
alias home='cd "$HOME"'
alias dotscripts='cd "$DOTSCRIPTS"'
alias icloud='cd "$ICLOUD"'
alias repos='cd "$REPOS"'
alias ghrepos='cd "$GHREPOS"'
alias gr='cd "$GHREPOS"'

# Git shortcuts
alias gp='git pull'
alias gs='git status'
alias lg='lazygit'

alias gst='git status --short --branch'
alias glog='git log --graph --decorate --oneline --all'
alias glast='git log -1 HEAD'
alias gunstage='git restore --staged --'
alias gamend='git commit --amend --no-edit'
alias gff='git pull --ff-only'
alias gprune='git fetch --prune'
alias grb='git rebase'
alias grbi='git rebase --interactive'
alias gr1='git reset --mixed HEAD~1'
alias gr2='git reset --mixed HEAD~2'
alias gr3='git reset --mixed HEAD~3'
alias gr4='git reset --mixed HEAD~4'

if [[ "${OSTYPE:-}" == darwin* ]]; then
	alias ls='ls -G'
else
	alias ls='ls --color=auto'
fi
alias la='ls -lathr'
alias lastmod='find . -type f -not -path "*/.*" -exec ls -lrt {} +'

# Zsh uses Emacs-style line editing by default, which has no Shift+Arrow
# selection bindings. Add the familiar bindings without affecting Bash.
if [[ -n ${ZSH_VERSION:-} ]]; then
	__dotfiles_select_left() {
		if (( ! REGION_ACTIVE )); then
			MARK=$CURSOR
			REGION_ACTIVE=1
		fi
		zle backward-char
	}

	__dotfiles_select_right() {
		if (( ! REGION_ACTIVE )); then
			MARK=$CURSOR
			REGION_ACTIVE=1
		fi
		zle forward-char
	}

	zle -N __dotfiles_select_left
	zle -N __dotfiles_select_right
	for keymap in emacs viins; do
		bindkey -M "$keymap" '^[[1;2D' __dotfiles_select_left
		bindkey -M "$keymap" '^[[1;2C' __dotfiles_select_right
	done
	unset keymap
fi

# ------------------------------------------------------------
# Functions
# ------------------------------------------------------------

if command -v bat >/dev/null 2>&1; then
	export FZF_PREVIEW_COMMAND='bat --color=always --style=numbers'
elif command -v batcat >/dev/null 2>&1; then
	export FZF_PREVIEW_COMMAND='batcat --color=always --style=numbers'
else
	export FZF_PREVIEW_COMMAND='sed -n "1,160p"'
fi

ff() {
	local file

	__dotfiles_require rg fzf nvim || return
	file=$(rg --files | fzf --prompt='File > ' --preview="$FZF_PREVIEW_COMMAND {} 2>/dev/null") || return
	nvim "$file"
}

fdc() {
	local dir

	__dotfiles_require fzf || return
	dir=$(find . -type d -not -path '*/.git/*' 2>/dev/null | fzf --prompt='Directory > ') || return
	cd "$dir" || return
}

# Oh My Zsh's Git plugin defines these names as aliases. Remove them before
# defining our fzf-based helpers; `function name { ... }` also avoids Zsh
# expanding a pre-existing alias while it parses this file.
unalias gb gt gf gv gl 2>/dev/null

function gb {
	local branch

	__dotfiles_require git fzf || return
	branch=$(git branch --all --format='%(refname:short)' | sed 's#^origin/##' | grep -v 'HEAD' | sort -u | fzf --prompt='Branch > ' --preview='git log --oneline --graph --color=always -20 {}') || return
	git switch "$branch" 2>/dev/null || git switch --track "origin/$branch"
}

function gt {
	local tag

	__dotfiles_require git fzf || return
	tag=$(git tag --sort=-creatordate | fzf --prompt='Tag > ' --preview='git show --color=always {}') || return
	git checkout "$tag"
}

function gf {
	local file

	__dotfiles_require git fzf || return
	file=$(git ls-files | fzf --prompt='File > ' --preview="${FZF_PREVIEW_COMMAND} {} 2>/dev/null") || return
	printf '%s\n' "$file"
}

function gv {
	local file

	__dotfiles_require git fzf nvim || return
	file=$(git ls-files | fzf --prompt='Edit > ' --preview="${FZF_PREVIEW_COMMAND} {} 2>/dev/null") || return
	nvim "$file"
}

function gl {
	local commit

	__dotfiles_require git fzf || return
	commit=$(git log --oneline | fzf --prompt='Commit > ' --preview='git show --color=always {1}') || return
	git show "${commit%% *}"
}
